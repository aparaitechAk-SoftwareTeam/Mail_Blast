PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/student_email_blast
JWT_SECRET=aparaitech_super_secret_jwt_key_2026_recruitment_email_blast
JWT_EXPIRE=7d

# Mail Transporter Config (Defaults to simulated fallback if credentials empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=recruitment@aparaitech.com
SMTP_PASS=
SMTP_FROM_NAME=Aparaitech Recruitment Team
SMTP_FROM_EMAIL=recruitment@aparaitech.com

# Rate limiting for email queue (emails per second)
EMAIL_BATCH_SIZE=5
EMAIL_DELAY_MS=200
